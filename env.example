# Port
PORT=3000

# Claude API Key (obtenha em https://console.anthropic.com)
CLAUDE_API_KEY=sk-ant-v0-seu-chave-aqui

# Netlify Site URL (seu link do teste)
NETLIFY_SITE_URL=https://seu-nome.netlify.app

# Data directory (onde salvar respostas)
DATA_DIR=/tmp/casais-data

# Environment
NODE_ENV=production

# IDs fixos do casal (usados nos endpoints e no agendamento automático)
COUPLE_PERSON_1_ID=tamyris
COUPLE_PERSON_2_ID=saulo

# Janela de entrega das dicas quinzenais (2x/semana, seg e qui)
TIPS_START_DATE=2026-09-04
TIPS_END_DATE=2027-01-31
TIPS_DELIVERY_HOUR=9

# Modelo Claude usado pelos agentes (opcional)
CLAUDE_MODEL=claude-opus-4-1

# Chave pra usar o endpoint de reset de dados de teste (opcional — sem essa
# variável, o endpoint /api/admin/reset fica sempre desligado). Escolha uma
# senha só sua. Uso: GET /api/admin/reset/tamyris/saulo?key=SUA_SENHA&confirm=SIM
# A mesma chave também libera o ?force=true em /api/tips/generate.
ADMIN_RESET_KEY=escolha-uma-senha-so-sua

# Notificações push (Web Push) — pra avisar direto no celular quando uma
# dica nova chega, sem depender do Google Agenda. Sem essas duas
# variáveis, essa parte fica desligada (o resto do app funciona igual).
# Par de chaves já gerado, prontas pra usar — se preferir gerar o seu:
# `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=BJ5s80WWoOSWz2A6CnVkcEi_y1h-Omk-mhOyGht0dFm10FYsIccYb7AL0IzaH5P-HlHmYgRHOQ82OOwBfRStHXo
VAPID_PRIVATE_KEY=5CDzk8waLsHSwleK6MprJtefICnriOug_bJWLmVgDgc
VAPID_SUBJECT=mailto:tamy.adps@gmail.com
